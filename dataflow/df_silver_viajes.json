{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ViajeId = trim(ViajeId),",
				"          RutaHistoricaId = upper(trim(RutaHistoricaId)),",
				"          VehiculoId = upper(trim(VehiculoId)),",
				"          EstadoViaje = iifNull(upper(trim(EstadoViaje)), 'DESCONOCIDO')) ~> derivedColumn1",
				"derivedColumn1 derive(FechaServicio = iif(instr(FechaServicio, '/') > 0, toDate(FechaServicio, 'dd/MM/yyyy'), toDate(FechaServicio, 'yyyy-MM-dd')),",
				"          ValidacionesTarjeta = toInteger(iifNull(ValidacionesTarjeta, '0')),",
				"          KmRecorridos = toDecimal(iifNull(KmRecorridos, '0'), 8, 1),",
				"          RutaHistoricaId = regexReplace(toString(byName('RutaHistoricaId')), '(-NEW|-N|-S)$', '')) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false,",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}