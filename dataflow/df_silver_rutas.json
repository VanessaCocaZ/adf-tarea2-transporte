{
	"name": "df_silver_rutas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "filter1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "filter2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(RutaHistoricaId = trim(RutaHistoricaId),",
				"          CodigoRuta = upper(trim(CodigoRuta))) ~> derivedColumn1",
				"derivedColumn1 derive(NombreRuta = iifNull(upper(trim(NombreRuta)), 'SIN NOMBRE'),",
				"          Origen = iifNull(upper(trim(Origen)), 'DESCONOCIDO'),",
				"          Destino = iifNull(upper(trim(Destino)), 'DESCONOCIDO')) ~> derivedColumn2",
				"derivedColumn2 derive(Estado = iifNull(upper(trim(Estado)), 'DESCONOCIDO'),",
				"          VigenciaDesde = iif(instr(VigenciaDesde, '/') > 0, toDate(VigenciaDesde, 'dd/MM/yyyy'), toDate(VigenciaDesde, 'yyyy-MM-dd')),",
				"          VigenciaHasta = iif(instr(VigenciaHasta, '/') > 0, toDate(VigenciaHasta, 'dd/MM/yyyy'), toDate(VigenciaHasta, 'yyyy-MM-dd'))) ~> derivedColumn3",
				"derivedColumn3 derive(RutaHistoricaId = iifNull(trim(RutaHistoricaId), 'RUTA_DESCONOCIDA'),",
				"          AnioFuente = iif(isNull(AnioFuente) || trim(toString(AnioFuente)) == '' || toString(AnioFuente) == 'NULL', 2024, toInteger(trim(toString(AnioFuente))))) ~> derivedColumn4",
				"derivedColumn4 derive(RutaHistoricaId = regexReplace(RutaHistoricaId, '(-NEW|-N|-S)$', ''),",
				"          CodigoRuta = concat('R-', lpad(regexReplace(CodigoRuta, '[^0-9]', ''), 2, '0'))) ~> derivedColumn5",
				"derivedColumn5 filter(RutaHistoricaId != 'RUTA DESCONOCIDA' && RutaHistoricaId != 'RUTA_DESCONOCIDA' && !isNull(RutaHistoricaId)) ~> filter1",
				"filter2 aggregate(groupBy(RutaHistoricaId),",
				"     CodigoRuta = first(CodigoRuta),",
				"          NombreRuta = first(NombreRuta),",
				"          Origen = first(Origen),",
				"          Destino = first(Destino),",
				"          VigenciaDesde = min(VigenciaDesde),",
				"          VigenciaHasta = max(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"filter1 filter(!isNull(RutaHistoricaId) && RutaHistoricaId != 'RUTA_DESCONOCIDA' && RutaHistoricaId != 'RUTA DESCONOCIDA' && regexMatch(upper(NombreRuta), '^RUTA\\\\s+[0-9]+\\\\s+(NORTE|SUR)$')) ~> filter2",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false,",
				"     mapColumn(",
				"          RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}